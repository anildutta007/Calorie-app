# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string, used for meal storage. Get one by adding a
# Postgres/Neon database in your Vercel project's Storage tab (it will set
# this automatically), or by creating a free database at https://neon.tech.
DATABASE_URL=postgres://...

# Optional: override the model used for nutrition analysis
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: server port (Render sets this automatically)
# PORT=3000
